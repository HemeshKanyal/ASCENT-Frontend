# Copy to .env.local and fill in. Never commit real keys.
# Server-only (not bundled into the app): used by app/api/meal-photo+api.ts
# Set ONE provider. Gemini wins if both are set.
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-flash-latest)
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Optional: model for meal photo analysis (default claude-opus-5-5)
ASCENT_MEAL_MODEL=
